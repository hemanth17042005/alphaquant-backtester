# =============================================================================
# ALPHAQUANT PLATFORM - SMTP EMAIL CONFIGURATION
# =============================================================================
# To send real verification OTP emails to users' real email inboxes,
# copy this file to `.env` and fill in your SMTP credentials below.

# --- GMAIL SMTP SETUP (Recommended for Quick Setup) ---
# 1. Enable 2-Step Verification in your Google Account (https://myaccount.google.com/security)
# 2. Search for "App Passwords" and create a password for "AlphaQuant"
# 3. Paste your 16-character App Password below (without spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM=AlphaQuant Security <your_gmail_address@gmail.com>

# --- BREVO (SENDINBLUE) / SENDGRID / CUSTOM SMTP SETUP (Alternative) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your_brevo_smtp_login
# SMTP_PASSWORD=your_brevo_smtp_key
# SMTP_FROM=AlphaQuant <no-reply@yourdomain.com>
